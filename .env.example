# RPC untuk baca state (getChallenge, miningState) — pakai Infura/Alchemy/dsb yang cepat
RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY

# RPC untuk kirim mine() transaction — pakai salah satu:
#   Flashbots Protect : https://rpc.flashbots.net/fast
#   MEV-Blocker       : https://rpc.mevblocker.io/fast
# Kalau dikosongkan, TX dikirim lewat RPC_URL biasa (public mempool)
PRIVATE_RPC_URL=https://rpc.flashbots.net/fast

# Private key wallet khusus mining (jangan pakai wallet utama!)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY
